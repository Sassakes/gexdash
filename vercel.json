{
  "functions": {
    "api/gex.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 14 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "30 23 * * 0-4"
    },
    {
      "path": "/api/cron?intraday=1&flowforce=1",
      "schedule": "30,40,50 13 * * 1-5"
    },
    {
      "path": "/api/cron?intraday=1&flowforce=1",
      "schedule": "*/10 14-18 * * 1-5"
    },
    {
      "path": "/api/cron?intraday=1&flowforce=1",
      "schedule": "*/5 19 * * 1-5"
    },
    {
      "path": "/api/cron?intraday=1&flowforce=1",
      "schedule": "0 20 * * 1-5"
    }
  ]
}