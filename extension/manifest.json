{
  "manifest_version": 3,
  "name": "The Hub — GEX Levels for TradingView",
  "version": "1.0.0",
  "description": "Auto-fills your GEX Daily Levels indicator on TradingView. Walls, gamma flip, expected move — updated without copy-pasting.",
  "permissions": ["storage", "alarms", "notifications", "clipboardWrite"],
  "host_permissions": [
    "https://www.dash.gexdash.app/*",
    "https://*.tradingview.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TheHub GEX Levels"
  }
}
